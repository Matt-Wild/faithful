<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="libs\**" />
    <EmbeddedResource Remove="libs\**" />
    <None Remove="libs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="R2API.Items" Version="1.0.7" />
    <PackageReference Include="R2API.Language" Version="1.0.1" />
    <PackageReference Include="R2API.Prefab" Version="1.1.1" />
    <PackageReference Include="R2API.Director" Version="[2.3.6,)" />
    <PackageReference Include="R2API.RecalculateStats" Version="1.6.3" />
	  <PackageReference Include="R2API.Core" Version="5.3.0" />
	  <PackageReference Include="R2API.Colors" Version="1.0.3" />
	  <PackageReference Include="R2API.DamageType" Version="1.1.7" />
	  <PackageReference Include="R2API.Deployable" Version="1.0.1" />
    <PackageReference Include="R2API.ContentManagement" Version="1.0.10" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Facepunch.Steamworks">
      <HintPath>libs\Facepunch.Steamworks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KdTreeLib">
      <HintPath>libs\KdTreeLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Security">
      <HintPath>libs\Mono.Security.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="pb_Stl">
      <HintPath>libs\pb_Stl.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Poly2Tri">
      <HintPath>libs\Poly2Tri.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProBuilderCore">
      <HintPath>libs\ProBuilderCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProBuilderMeshOps">
      <HintPath>libs\ProBuilderMeshOps.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Windows_Lib">
      <HintPath>libs\Rewired_Windows_Lib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimpleJSON">
      <HintPath>libs\SimpleJSON.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zio">
      <HintPath>libs\Zio.dll</HintPath>
      <Private>false</Private>
    </Reference>
	<Reference Include="ItemQualities">
	  <HintPath>libs\ItemQualities.dll</HintPath>
	  <Private>false</Private>
	</Reference>
    <Reference Include="Faithful.Shared">
      <HintPath>libs\Faithful.Shared.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="NetworkWeaver\Weave.ps1;NetworkWeaver\Unity.UNetWeaver.exe;NetworkWeaver\Unity.Cecil*.dll" />
  </ItemGroup>

  <!-- Patch the build output before post-build events run. -->
  <Target Name="WeaveFaithful" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_WeaverDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'NetworkWeaver'))</_WeaverDirectory>
    </PropertyGroup>

    <MakeDir Directories="$(_WeaverDirectory)" />
    <WriteLinesToFile File="$(_WeaverDirectory)References.txt" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\NetworkWeaver\Weave.ps1&quot; -AssemblyPath &quot;@(IntermediateAssembly->'%(FullPath)')&quot; -SymbolsPath &quot;@(_DebugSymbolsIntermediatePath->'%(FullPath)')&quot; -ReferenceList &quot;$(_WeaverDirectory)References.txt&quot; -WorkingDirectory &quot;$(_WeaverDirectory).&quot;" StandardOutputImportance="Low" />

    <Copy SourceFiles="$(_WeaverDirectory)Output\$(TargetFileName)" DestinationFiles="$(TargetPath)" />
    <Copy SourceFiles="$(_WeaverDirectory)Output\$(TargetName).pdb" DestinationFiles="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(_WeaverDirectory)Output\$(TargetName).pdb')" />
    <Delete Files="$(TargetDir)$(TargetName).pdb" Condition="!Exists('$(_WeaverDirectory)Output\$(TargetName).pdb')" />
    <Delete Files="$(TargetPath).mdb" />

    <ItemGroup>
      <FileWrites Include="$(_WeaverDirectory)**\*;$(TargetPath)" />
      <FileWrites Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Message Text="Faithful networking patched successfully." Importance="High" />
  </Target>

</Project>
